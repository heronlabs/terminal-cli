# Database connection (target of backup / restore).
# Either a raw connection URL or an AWS SSM Parameter Store ARN resolved by
# @heronlabs/env-ssm (postgres:// or mysql://user:pass@host:port/dbname).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mydb

# S3 destination for remote backups (omit --local to use S3)
AWS_S3_BUCKET_NAME=my-backup-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sentry errors + pino logs (off when SENTRY_DSN is unset or empty)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Sentry Cron monitor slug for backup check-ins (optional)
SENTRY_MONITOR_SLUG=
