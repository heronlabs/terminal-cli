# Database connection (target of backup / restore).
# Either a raw connection URL or an AWS SSM Parameter Store ARN resolved by
# @heronlabs/env-ssm (postgres:// or mysql://user:pass@host:port/dbname).
# Only the psql-* / mysql-* commands use this; easypanel-* ignores it.
DB_URL=postgres://postgres:postgres@localhost:5432/mydb

# S3 destination for remote backups (omit --local to use S3)
# The easypanel-backup / easypanel-rollup commands need ONLY these AWS_* vars
# (no DB vars) — they snapshot the host, not a database.
AWS_S3_BUCKET_NAME=my-backup-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
