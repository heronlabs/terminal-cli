# Database connection (target of backup / restore)
# Only the psql-* / mysql-* commands use these; easypanel-* ignores them.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=postgres

# S3 destination for remote backups (omit --local to use S3)
# The easypanel-backup / easypanel-rollup commands need ONLY these AWS_* vars
# (no DB vars) — they snapshot the host, not a database.
AWS_S3_BUCKET_NAME=my-backup-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
