{
  "services": [
    {
      "data": {
        "deploy": {
          "command": "printenv > /etc/environment && chmod 600 /etc/environment && hcli mysql-backup && crond -f -d 8",
          "replicas": 1
        },
        "env": "DB_URL=mysql://user:password@host:3306/dbname\nAWS_S3_BUCKET_NAME=my-backup-bucket\nAWS_REGION=us-east-1\nAWS_ACCESS_KEY_ID=\nAWS_SECRET_ACCESS_KEY=",
        "mounts": [
          {
            "content": "0 */12 * * *\t. /etc/environment; hcli mysql-backup\n",
            "mountPath": "/etc/crontabs/root",
            "type": "file"
          }
        ],
        "projectName": "backups",
        "serviceName": "mysql-backup",
        "source": {
          "image": "heronlabs/terminal-cli:CHANGE_ME",
          "type": "image"
        }
      },
      "type": "app"
    }
  ]
}
